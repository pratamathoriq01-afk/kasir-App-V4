generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MenuItem {
  id         String            @id @default(cuid())
  name       String
  category   String
  price      Int
  hpp        Int
  taxPercent Int               @default(10)
  icon       String?
  imageUrl   String?
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  items      TransactionItem[]
}

model Transaction {
  id              String            @id @default(cuid())
  orderNumber     String            @unique
  customerName    String?
  orderType       String
  tableNumber     String?
  subtotal        Int
  discountType    String?
  discountValue   Int               @default(0)
  discountAmount  Int               @default(0)
  tax             Int
  total           Int
  hppTotal        Int
  netProfit       Int
  cashReceived    Int
  change          Int
  createdAt       DateTime          @default(now())
  orderStatus     String?           @default("NEW_ORDER")
  customerPhone   String?
  customerEmail   String?
  deliveryCourier String?
  orderNotes      String?
  paymentStatus   String?           @default("PAID")
  paymentMethod   String?           @default("QRIS")
  items           TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  menuItemId    String?
  nameSnapshot  String
  priceSnapshot Int
  hppSnapshot   Int
  qty           Int
  menuItem      MenuItem?   @relation(fields: [menuItemId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])
}

model MonthlyArchive {
  id           String   @id @default(cuid())
  month        Int
  year         Int
  totalRevenue Int
  totalHpp     Int
  netProfit    Int
  totalTax     Int
  createdAt    DateTime @default(now())
}

model Voucher {
  id            String    @id
  code          String    @unique
  title         String
  description   String
  discountType  String
  discountValue Int
  maxDiscount   Int?
  minSubtotal   Int
  validUntil    String
  isActive      Boolean?  @default(true)
  createdAt     DateTime? @default(now()) @db.Timestamp(6)
}
